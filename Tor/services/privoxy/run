#!/command/with-contenv bash
# =============================================================================
# services/privoxy/run — s6-supervised service script. Writes
# /etc/privoxy/config from PRIVOXY_* env vars, then execs privoxy.
#
# This runs alongside services/tor/run under s6-overlay (see ../../Dockerfile
# and /init) as one of two independently-supervised services in this image.
# If privoxy crashes, s6 restarts ONLY this service — tor keeps running
# undisturbed. Conversely if tor restarts, privoxy is not restarted; it will
# simply fail to reach the SOCKS port until tor is back, then recover on its
# own (Privoxy retries the upstream connection per-request, it doesn't need
# to be restarted itself).
#
# PRIVOXY_ENABLE controls whether Privoxy runs at all in this image — the
# same image can run Tor-only (PRIVOXY_ENABLE=false, the default) or
# Tor+Privoxy together (PRIVOXY_ENABLE=true). When disabled, this script
# blocks forever via `sleep infinity` instead of exiting, so s6 sees the
# service as "up" and does not restart-loop it — a service in
# /etc/services.d that exits immediately gets endlessly relaunched by s6,
# which would spam logs for something that's deliberately turned off.
#
# PRIVOXY_TOR_SOCKS_HOST defaults to 127.0.0.1 here, NOT "tor" — this is a
# behavior change from the old, separate tor-privoxy image, where Tor and
# Privoxy were different containers on a Compose network and had to be
# reached by service name. In this merged image both processes share one
# network namespace, so Privoxy reaches Tor's SOCKS port over loopback.
#
# NOTE on Alpine packaging: the privoxy apk package ships every stock
# config/action/filter file with a ".new" suffix (default.filter.new,
# default.action.new, etc.) rather than installing them live, so a fresh
# container has no plain default.filter/default.action until this script
# stages them (see the loop before write_config below). This is
# Alpine-specific — other distros' privoxy packages install these files
# directly under their real names.
#
# -----------------------------------------------------------------------
# Variables
# -----------------------------------------------------------------------
# PRIVOXY_ENABLE           default: false           -> when false, this
#                           service idles (sleep infinity) instead of
#                           running privoxy at all. Set true to enable the
#                           HTTP/HTTPS front-end.
# PRIVOXY_LISTEN_ADDRESS   default: 0.0.0.0        -> listen-address host
# PRIVOXY_LISTEN_PORT      default: 8118           -> listen-address port
# PRIVOXY_TOR_SOCKS_HOST   default: 127.0.0.1      -> host of the upstream
#                           Tor SOCKS5 proxy. Defaults to loopback since
#                           tor runs in the same container/network
#                           namespace as this service.
# PRIVOXY_TOR_SOCKS_PORT   default: 9050            -> port of the
#                           upstream Tor SOCKS5 proxy — should match
#                           TORRC_SOCKS_PORT for the tor service in this
#                           same container (also 9050 by default).
# PRIVOXY_FORWARD_DNS      default: true            -> when true, uses
#                           socks5t (Tor resolves DNS remotely, avoiding
#                           local DNS leaks); when false, uses socks5
#                           (DNS resolved locally by Privoxy/the host —
#                           NOT recommended, leaks hostnames outside Tor).
# PRIVOXY_ENABLE_FILTERS   default: true            -> toggles Privoxy's
#                           default content-filtering (ads/trackers/
#                           banners) via the `filterfile default.filter`
#                           + per-request `+filter{...}` action groups
#                           shipped with the apk package. When false,
#                           traffic is forwarded with no filtering, pure
#                           relay-only behavior.
# PRIVOXY_ENABLE_LOGGING   default: false           -> when true, enables
#                           Privoxy's own request logging (`debug 1` +
#                           logfile). Off by default since verbose
#                           request logs are themselves a privacy leak on
#                           an anonymizing proxy.
# PRIVOXY_TRUSTED_CIDRS    default: (unset)         -> comma-separated
#                           CIDRs allowed to connect, written as
#                           `permit-access` lines, e.g.
#                           "10.0.0.0/8,192.168.0.0/16". When unset,
#                           Privoxy's default (accept from wherever
#                           listen-address binds) applies — restrict this
#                           in any multi-tenant/shared-network deployment.
# =============================================================================
set -euo pipefail

: "${PRIVOXY_ENABLE:=false}"

if [ "${PRIVOXY_ENABLE}" != "true" ]; then
    # Deliberately idle, not exit — see header comment. This keeps s6 from
    # restart-looping a service that's intentionally turned off.
    exec sleep infinity
fi

CONFIG=/etc/privoxy/config

: "${PRIVOXY_LISTEN_ADDRESS:=0.0.0.0}"
: "${PRIVOXY_LISTEN_PORT:=8118}"
: "${PRIVOXY_TOR_SOCKS_HOST:=127.0.0.1}"
: "${PRIVOXY_TOR_SOCKS_PORT:=9050}"
: "${PRIVOXY_FORWARD_DNS:=true}"
: "${PRIVOXY_ENABLE_FILTERS:=true}"
: "${PRIVOXY_ENABLE_LOGGING:=false}"
: "${PRIVOXY_TRUSTED_CIDRS:=}"

write_config() {
    : > "${CONFIG}"

    echo "listen-address ${PRIVOXY_LISTEN_ADDRESS}:${PRIVOXY_LISTEN_PORT}" >> "${CONFIG}"

    if [ "${PRIVOXY_FORWARD_DNS}" = "true" ]; then
        echo "forward-socks5t / ${PRIVOXY_TOR_SOCKS_HOST}:${PRIVOXY_TOR_SOCKS_PORT} ." >> "${CONFIG}"
    else
        echo "forward-socks5 / ${PRIVOXY_TOR_SOCKS_HOST}:${PRIVOXY_TOR_SOCKS_PORT} ." >> "${CONFIG}"
    fi

    echo "confdir /etc/privoxy" >> "${CONFIG}"
    echo "templdir /etc/privoxy/templates" >> "${CONFIG}"

    if [ "${PRIVOXY_ENABLE_LOGGING}" = "true" ]; then
        echo "logdir /var/log/privoxy" >> "${CONFIG}"
        echo "logfile privoxy.log" >> "${CONFIG}"
        echo "debug 1" >> "${CONFIG}"
    fi

    if [ "${PRIVOXY_ENABLE_FILTERS}" = "true" ]; then
        echo "actionsfile default.action" >> "${CONFIG}"
        echo "filterfile default.filter" >> "${CONFIG}"
    fi

    if [ -n "${PRIVOXY_TRUSTED_CIDRS}" ]; then
        IFS=',' read -ra _cidrs <<< "${PRIVOXY_TRUSTED_CIDRS}"
        for cidr in "${_cidrs[@]}"; do
            echo "permit-access ${cidr}" >> "${CONFIG}"
        done
    fi
}

mkdir -p /etc/privoxy /var/log/privoxy

for staged in /etc/privoxy/*.new; do
    [ -e "${staged}" ] || continue
    target="${staged%.new}"
    if [ ! -e "${target}" ]; then
        cp "${staged}" "${target}"
    fi
done

chown -R privoxy:privoxy /etc/privoxy /var/log/privoxy 2>/dev/null || true

write_config

exec su-exec privoxy privoxy --no-daemon "${CONFIG}"
